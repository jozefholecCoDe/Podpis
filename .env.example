# Doména, na ktorej aplikácia beží. Vypĺňa sa iba pri nasadení na server
# (pozri NASADENIE.md), pri spúšťaní z domáceho počítača sa nepoužíva.
DOMAIN=podpis.vasadomena.sk

# Heslo do aplikácie. Chráni nahrávanie dokumentov a zoznam dokumentov.
# Odkazy na podpis (/sign/...) fungujú aj bez neho, aby sa klient vedel podpísať.
# Ak necháte prázdne, aplikácia beží bez hesla a upozorní na to na úvodnej stránke.
APP_PASSWORD=zvolte-si-heslo

# SMTP nastavenia na odosielanie emailu s odkazom na podpis
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vas-email@gmail.com
SMTP_PASS=vase-app-password
SMTP_SECURE=false
SMTP_FROM=vas-email@gmail.com

# Verejná URL aplikácie (použije sa v odkaze na podpis v emaile).
# Ak necháte prázdne, odvodí sa z hlavičiek HTTP požiadavky.
APP_BASE_URL=http://localhost:3000
